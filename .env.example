GEMINI_API_KEY=replace-with-your-private-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: if GEMINI_MODEL fails (timeout, quota, outage), the system
# automatically retries once with this fallback model before giving up.
# Leave blank/unset to disable fallback.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash